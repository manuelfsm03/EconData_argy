// Panel de Control - Financial Data Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Exchange Rates - Tipos de Cambio
model ExchangeRate {
  id            String   @id @default(cuid())
  date          DateTime
  blue          Float?
  cclLibre      Float?   @map("ccl_libre")
  cclControlado Float?   @map("ccl_controlado")
  mepLibre      Float?   @map("mep_libre")
  mepControlado Float?   @map("mep_controlado")
  oficial       Float?   // BNA
  mayorista     Float?
  a3500         Float?
  solidario     Float?
  cripto        Float?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([date])
  @@map("exchange_rates")
}

// Brecha - Gap between exchange rates
model ExchangeGap {
  id              String   @id @default(cuid())
  date            DateTime
  brechaMepBlue   Float?   @map("brecha_mep_blue")
  brechaCclBlue   Float?   @map("brecha_ccl_blue")
  brechaMepOficial Float?  @map("brecha_mep_oficial")
  brechaCclOficial Float?  @map("brecha_ccl_oficial")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([date])
  @@map("exchange_gaps")
}

// Inflacion Argentina
model Inflation {
  id             String   @id @default(cuid())
  date           DateTime
  monthly        Float?   // Variacion mensual
  yearToDate     Float?   @map("year_to_date") // YTD
  interannual    Float?   // Interanual
  accumulated    Float?   // Acumulado total
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([date])
  @@map("inflation")
}

// Rofex Futures - Futuros de Dolar
model RofexFuture {
  id                String   @id @default(cuid())
  date              DateTime
  position          String   // e.g., DLR052023
  maturity          DateTime
  maturityLabel     String?  @map("maturity_label") // e.g., May-2023
  price             Float?
  devaluation       Float?   // Devaluacion implícita
  monthlyDevaluation Float?  @map("monthly_devaluation")
  tna               Float?   // Tasa Nominal Anual
  cft               Float?   // Costo Financiero Total
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([date, position])
  @@map("rofex_futures")
}

// US Treasury and Fed Rates
model USTreasury {
  id                String   @id @default(cuid())
  date              DateTime
  yield10Y          Float?   @map("yield_10y")
  tips10Y           Float?   @map("tips_10y")
  expectedInflation Float?   @map("expected_inflation")
  fedFundsRate      Float?   @map("fed_funds_rate")
  usInflation       Float?   @map("us_inflation")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([date])
  @@map("us_treasury")
}

// Tasa Badlar
model BadlarRate {
  id        String   @id @default(cuid())
  date      DateTime
  rate      Float?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([date])
  @@map("badlar_rates")
}

// Merval Index
model MervalIndex {
  id        String   @id @default(cuid())
  date      DateTime
  value     Float?
  volume    Float?
  change    Float?   // Daily change %
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([date])
  @@map("merval_index")
}

// Crypto Exchange Rates
model CryptoRate {
  id        String   @id @default(cuid())
  date      DateTime
  exchange  String   // e.g., binance, buenbit, ripio
  usdtArs   Float?   @map("usdt_ars")
  btcArs    Float?   @map("btc_ars")
  usdcArs   Float?   @map("usdc_ars")
  daiArs    Float?   @map("dai_ars")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([date, exchange])
  @@map("crypto_rates")
}

// News Feed Items
model NewsItem {
  id          String   @id @default(cuid())
  title       String
  link        String
  description String?
  source      String   // RSS source name
  pubDate     DateTime @map("pub_date")
  category    String?
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([link])
  @@map("news_items")
}

// Scrape Logs - For monitoring
model ScrapeLog {
  id          String   @id @default(cuid())
  source      String   // e.g., rava, finanzasargy, criptoya
  status      String   // success, error, partial
  message     String?
  recordsAdded Int?    @map("records_added")
  duration    Int?     // in milliseconds
  startedAt   DateTime @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("scrape_logs")
}

// Data Sources Configuration
model DataSource {
  id          String   @id @default(cuid())
  name        String   @unique
  url         String
  type        String   // scrape, api, rss
  enabled     Boolean  @default(true)
  lastRun     DateTime? @map("last_run")
  lastStatus  String?  @map("last_status")
  cronSchedule String? @map("cron_schedule")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("data_sources")
}

// ─── FASE 1: RENTA FIJA ───────────────────────────────────────────────────────

// Bonos soberanos hard dollar (AL/GD series)
model SovereignBond {
  id              String        @id @default(cuid())
  ticker          String        @unique  // e.g., AL29, GD30
  nombre          String                 // Nombre completo
  moneda          String                 // USD, ARS
  ley             String                 // local, NY
  cupon           Float                  // % anual
  amortizacion    String                 // e.g., bullet, amortizing
  emision         DateTime?
  vencimiento     DateTime
  // Métricas calculadas (actualizadas diariamente)
  precio          Float?                 // Precio mercado (USD para HD)
  tir             Float?                 // TIR implícita %
  paridad         Float?                 // Precio / VN residual %
  currentYield    Float?        @map("current_yield")
  durationMod     Float?        @map("duration_mod")  // Duration modificada
  // Metadata
  updatedAt       DateTime      @updatedAt @map("updated_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  // Relations
  precios         BondPrice[]
  cashflows       BondCashflow[]

  @@map("sovereign_bonds")
}

// Precios históricos de bonos
model BondPrice {
  id        String        @id @default(cuid())
  bondId    String        @map("bond_id")
  date      DateTime
  priceUsd  Float?        @map("price_usd")   // Precio en USD (bonos HD)
  priceArs  Float?        @map("price_ars")   // Precio en ARS
  volume    Float?
  source    String        @default("rava")   // rava, byma, manual
  createdAt DateTime      @default(now()) @map("created_at")

  bond      SovereignBond @relation(fields: [bondId], references: [id])

  @@unique([bondId, date])
  @@map("bond_prices")
}

// Flujos de pagos (cupones + amortizaciones)
model BondCashflow {
  id          String        @id @default(cuid())
  bondId      String        @map("bond_id")
  fechaPago   DateTime      @map("fecha_pago")
  cupon       Float         @default(0)         // Cupón en USD por lámina
  amortizacion Float        @default(0) @map("amortizacion") // Amortización en USD
  flujoTotal  Float         @map("flujo_total")               // cupon + amortizacion

  bond        SovereignBond @relation(fields: [bondId], references: [id])

  @@map("bond_cashflows")
}

// Instrumentos de tasa fija en pesos (LECAPs, BONCAPs, etc.)
model CapInstrument {
  id            String    @id @default(cuid())
  ticker        String    @unique
  tipo          String               // LECAP, BONCAP, LECER, BONCER
  vencimiento   DateTime
  // Métricas calculadas
  precio        Float?               // Precio de mercado (% del VN)
  tir           Float?               // TIR %
  tea           Float?               // TEA %
  tem           Float?               // TEM %
  preciTecnico  Float?    @map("precio_tecnico")
  // Metadata
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  precios       CapPrice[]

  @@map("cap_instruments")
}

// Precios históricos de LECAPs/BONCAPs
model CapPrice {
  id           String        @id @default(cuid())
  instrumentId String        @map("instrument_id")
  date         DateTime
  precio       Float?
  tem          Float?
  volume       Float?
  source       String        @default("byma")
  createdAt    DateTime      @default(now()) @map("created_at")

  instrument   CapInstrument @relation(fields: [instrumentId], references: [id])

  @@unique([instrumentId, date])
  @@map("cap_prices")
}

// ─── BCRA Monetary Variables ──────────────────────────────────────────────────

// BCRA Monetary Variables - Reservas, Base Monetaria, etc.
model BCRAMonetaryData {
  id                String   @id @default(cuid())
  date              DateTime
  reservas          Float?   @map("reservas") // Reservas Internacionales (USD MM)
  baseMonetaria     Float?   @map("base_monetaria") // Base Monetaria (ARS MM)
  circulacion       Float?   @map("circulacion") // Circulacion Monetaria (ARS MM)
  prestamosPrivado  Float?   @map("prestamos_privado") // Prestamos Sector Privado (ARS MM)
  tcMinorista       Float?   @map("tc_minorista") // Tipo de Cambio Minorista
  tcMayorista       Float?   @map("tc_mayorista") // Tipo de Cambio Mayorista
  badlar            Float?   @map("badlar") // BADLAR %
  tm20              Float?   @map("tm20") // TM20 %
  depositos30d      Float?   @map("depositos_30d") // Tasas Depositos 30 dias %
  cer               Float?   @map("cer") // CER index
  uva               Float?   @map("uva") // UVA index
  uvi               Float?   @map("uvi") // UVI index
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([date])
  @@map("bcra_monetary_data")
}

// ─── Foro por Activo ───────────────────────────────────────────────────────

// Post de foro — un hilo cronológico único por (assetType, assetTicker).
// No hay modelo ForumThread: el "thread" es implícito, derivado de assetType+assetTicker.
model ForumPost {
  id              String          @id @default(cuid())
  assetType       String          @map("asset_type")   // "accion" | "bono" | "cap" | "variable"
  assetTicker     String          @map("asset_ticker") // ej. GGAL, AL29 — siempre uppercase
  authorName      String          @map("author_name")  // texto libre, sin cuenta
  content         String                               // texto plano, max 2000 chars (validado en API)
  parentId        String?         @map("parent_id")    // quote/reply opcional a otro post
  parent          ForumPost?      @relation("PostReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies         ForumPost[]     @relation("PostReplies")
  reactions       ForumReaction[]
  deleteTokenHash String?         @map("delete_token_hash")
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([assetType, assetTicker, createdAt])
  @@map("asset_forum_posts")
}

model ForumReaction {
  id            String    @id @default(cuid())
  postId        String    @map("post_id")
  post          ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  emoji         String
  identityToken String    @map("identity_token")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([postId, identityToken])
  @@index([postId])
  @@map("asset_forum_reactions")
}

// ─── COMUNIDAD ────────────────────────────────────────────────────────────────
// Autenticación (signup/login/sesiones) la maneja Supabase Auth.
// `id` acá = UUID de Supabase auth.users.id (no autogenerado por Prisma).
// Ver server/auth/get-or-create-profile.ts para la lógica de creación lazy.

model Profile {
  id          String   @id                                  // UUID de Supabase auth.users.id
  username    String   @unique
  displayName String?  @map("display_name")               // nombre completo
  avatarUrl   String?  @map("avatar_url")                 // URL foto de avatar
  avatarBg    String   @default("#1B2A4A") @map("avatar_bg") // color fallback cuando no hay foto

  // Permisos
  canPublish  Boolean  @default(false) @map("can_publish") // habilitar manualmente para publicar informes

  // Perfil de comunidad
  bio              String   @default("")
  linkedin         String?
  nivel            String   @default("Novato")             // Novato | Analista | Trader | Pro | Experto | Quant
  puntos           Int      @default(0)
  streak           Int      @default(0)
  posts            Int      @default(0)
  seguidores       Int      @default(0)
  aciertos         Int      @default(0)
  totalPrediciones Int      @default(0) @map("total_prediciones")
  fechaAlta        DateTime @default(now()) @map("fecha_alta")

  // Intereses e inversiones declaradas
  intereses              String[] @default([])              // lista plana (legacy display)
  interesesRentaFija     String[] @default([]) @map("intereses_renta_fija")
  interesesRentaVariable String[] @default([]) @map("intereses_renta_variable")
  perfilRiesgo           String?  @map("perfil_riesgo")    // conservador | moderado | agresivo
  topAcciones            Json     @default("[]") @map("top_acciones") // [{ticker, conviccion}]

  // Relaciones
  predictions Prediction[]
  reports     Report[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model Prediction {
  id              String   @id @default(cuid())
  autorId         String   @map("autor_id")
  autor           Profile  @relation(fields: [autorId], references: [id])
  activo          String                              // ticker: "GD30", "AL30", "GGAL"...
  tipoActivo      String   @map("tipo_activo")        // "bono" | "accion" | "fx" | "tasa" | "indice" | "cripto"
  tesis           String                              // razonamiento en texto libre
  metrica         String                              // "precio" | "tir" | "paridad" | "spread" | "variacion_pct"
  operador        String                              // "mayor_igual" | "menor_igual" | "sube" | "baja" | "rango"
  objetivo        Float?                              // umbral; null para operadores sube/baja
  objetivoMax     Float?   @map("objetivo_max")       // solo para operador "rango"
  valorEntrada    Float    @map("valor_entrada")      // foto inmutable al publicar
  fechaEntrada    DateTime @map("fecha_entrada")      // timestamp de publicación (inmutable)
  horizonte       String                              // label legible: "30 días", "al vencimiento"
  fechaResolucion DateTime @map("fecha_resolucion")
  estado          String   @default("abierta")        // "abierta" | "acertada" | "errada" | "anulada"
  valorResolucion Float?   @map("valor_resolucion")
  fechaResuelta   DateTime? @map("fecha_resuelta")
  fuente          String?                             // fuente/endpoint que dio el valor de resolución
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([autorId])
  @@index([estado, fechaResolucion])
  @@map("predictions")
}

model Report {
  id        String   @id @default(cuid())
  title     String
  body      String                        // Markdown (GFM)
  authorId  String   @map("author_id")
  author    Profile  @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("reports")
}
