# Variables de entorno de La Pizarra (EconData_argy).
# Copiar a .env.local para desarrollo, y cargar las mismas en el dashboard
# de Vercel (Settings -> Environment Variables) para producción.

# Postgres (Prisma). En Vercel normalmente la provee la integración de la DB.
DATABASE_URL="postgresql://usuario:password@host:5432/dbname"

# Protege /api/cron (dispara los scrapers) e /api/scrape/[source]. Sin esto
# configurado, esas rutas fallan cerradas (rechazan todo) a propósito.
CRON_SECRET=""

# Alternativa/legacy a CRON_SECRET para el mismo propósito -- admin-auth.ts
# acepta cualquiera de los dos. Preferir CRON_SECRET para código nuevo.
INGEST_SECRET=""

# U.S. Energy Information Administration. SIN esta key, /api/energia-global
# cae a datos de producción petrolera SIMULADOS (Math.random) en vez de reales
# -- es la causa confirmada de por qué la sección "Luz" se ve rota/inventada.
# Se consigue gratis y al toque en https://www.eia.gov/opendata/register.php
EIA_API_KEY=""

# Opcional: mejora /api/economia (riesgo país) con estadisticasbcra.com.
# Sin esto el endpoint sigue funcionando con las demás fuentes.
BCRA_TOKEN=""
